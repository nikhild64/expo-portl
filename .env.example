# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Razorpay (test mode)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Set to true to enable Hindi language toggle (onboarding + settings)
EXPO_PUBLIC_ENABLE_HINDI=false

# Sentry (client DSN — safe to embed in the app)
EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>

# Sentry build-time only (local .env or EAS secrets — never commit the auth token)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token
